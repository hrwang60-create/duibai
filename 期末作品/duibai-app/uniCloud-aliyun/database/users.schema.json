{
  "bsonType": "object",
  "required": [
    "openid"
  ],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "bsonType": "string",
      "description": "ID，系统自动生成"
    },
    "openid": {
      "bsonType": "string",
      "description": "微信 openid，唯一标识一个用户",
      "foreignKey": null
    },
    "nickname": {
      "bsonType": "string",
      "description": "昵称"
    },
    "avatar": {
      "bsonType": "string",
      "description": "头像 URL"
    },
    "role": {
      "bsonType": "string",
      "description": "角色：user / admin",
      "enum": [
        "user",
        "admin"
      ],
      "default": "user"
    },
    "status": {
      "bsonType": "int",
      "description": "状态：1 正常 / 0 封禁",
      "default": 1
    },
    "created_at": {
      "bsonType": "timestamp",
      "description": "注册时间"
    },
    "last_login": {
      "bsonType": "timestamp",
      "description": "最近登录时间"
    }
  },
  "index": [
    {
      "IndexName": "openid_uniq",
      "MgoKeySchema": {
        "MgoIndexKeys": [
          {
            "Name": "openid",
            "Direction": "1"
          }
        ],
        "MgoIsUnique": true
      }
    }
  ]
}